@using Flowly.Shared.Components.Button
@using Flowly.Shared.Components.Container
@using Flowly.Shared.Components.Logo
@using Flowly.Shared.Components.Stack
<Container
    Padding="Container.ContainerPadding.Medium"
    Size="Container.ContainerSize.Full"
    Direction="Container.ContainerDirection.Row"
    Class="border-b-2 border-border">
    <Stack
        Size="Stack.StackSize.Full"
        Align="Stack.StackAlign.Center"
        Direction="Stack.StackDirection.Row"
        Justify="Stack.StackJustify.Between">
        <Logo Size="Logo.LogoSize.Large" />

        <Stack
            As="nav"
            Direction="Stack.StackDirection.Row"
            Align="Stack.StackAlign.Center"
            Gap="Stack.StackGap.Small">
            @foreach (var link in links)
            {
                <Button
                    Href="@link.Href"
                    Size="Button.ButtonSize.Small"
                    FontSize="Button.ButtonFontSize.Medium"
                    TextColor="Button.ButtonColor.Muted"
                    TextWeight="Button.ButtonTextWeight.Medium">
                    @link.Name
                </Button>
            }
        </Stack>

        <Stack></Stack>
    </Stack>
</Container>

@code
{
    private record LinkModel(
                    string Name,
                    string Href
                );

    private readonly IEnumerable<LinkModel> links = [
        new("Home", "/"),
        new("Explore", "/explore"),
        new("Topics", "/topics"),
        new("Community", "/community"),
    ];
}
