@using Flowly.Shared.Components.Container
@using Flowly.Shared.Components.Stack
@using Flowly.Shared.Components.Text

<Container Padding="Container.ContainerPadding.Medium" Size="Container.ContainerSize.Full"
           Direction="Container.ContainerDirection.Row" Class="border-b-2 border-border">
    <Stack Align="Stack.StackAlign.Center" Direction="Stack.StackDirection.Row" Justify="Stack.StackJustify.Between">
        <Text As="h1" Variant="Text.TextVariant.Heading" Color="Text.TextColor.Primary" Font="Text.TextFont.Serif"
              Weight="Text.TextWeight.Bold" Tracking="Text.TextTracking.Wider">Flowly</Text>
    </Stack>
    <Stack></Stack>
</Container>
