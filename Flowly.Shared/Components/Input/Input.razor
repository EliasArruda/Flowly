@using Microsoft.AspNetCore.Components.Forms
<div class="@FieldCss">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="@LabelCss">
        @Label
        </label>
    }
    <div class="@WrapperCss">
        @if (StartIcon is not null)
        {
            <span class="@StartIconCss">
            @StartIcon
            </span>
        }
        @if (As == InputAs.Blazor)
        {
            <InputText
                @bind-Value="Value"
                class="@Css"
                @attributes="AdditionalAttributes" />
        }
        else
        {
            <input
                value="@Value"
                @oninput="HandleInput"
                class="@Css"
                @attributes="AdditionalAttributes" />
        }
        @if (EndIcon is not null)
        {
            <span class="@EndIconCss">
            @EndIcon
            </span>
        }
    </div>
</div>
